# Board-declared FAT media needs logical names longer than DOS 8.3.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_LFN_NONE=n
CONFIG_FATFS_LFN_STACK=n
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_FS_LOCK=8
# Bound FAT caches to the 512-byte sectors used by SD/MMC.
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_SECTOR_4096=n
CONFIG_FATFS_PER_FILE_CACHE=y
