# Opt-in NimBLE profile. The ordinary six-board build excludes Bluetooth.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Private show-network policy: GATT control does not require pairing/encryption.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
# One peripheral connection with application-fragmented writes/notifications.
# Keep eight MTU-sized buffers, but avoid central/mesh-sized event pools.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
# BLIP implements its own bounded fragmentation, not ATT Prepare Write.
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=0
