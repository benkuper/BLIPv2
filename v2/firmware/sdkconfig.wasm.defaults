# Reserve internal RAM for the fixed script pool and worker stacks.
# Qualify Wi-Fi latency/throughput together with LED output and guest execution.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
# One supervisor tick is one millisecond; retain the declared 2 ms guard bound.
CONFIG_FREERTOS_HZ=1000
