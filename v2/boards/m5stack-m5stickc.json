{
  "schema_version": 1,
  "id": "m5stack-m5stickc",
  "target": "esp32",
  "sources": ["https://docs.m5stack.com/en/core/StickC", "https://github.com/Golden-Geek/BLIP/blob/1507f440b3ae635686d2bf759ecc742b391f08a7/configs/m5stick.ini"],
  "pins": [
    {"id":"gpio.0","label":"Microphone clock / HAT GPIO0","gpio":0,"capabilities":["output"],"electrical":"microphone clock; boot strap","reserved_for":"system.microphone","reason":"onboard-microphone-clock","selectable":false},
    {"id":"gpio.1","label":"UART0 TX / GPIO1","gpio":1,"capabilities":["output"],"electrical":"USB serial bridge","reserved_for":"system.serial","reason":"serial-console","selectable":false},
    {"id":"gpio.3","label":"UART0 RX / GPIO3","gpio":3,"capabilities":["input"],"electrical":"USB serial bridge","reserved_for":"system.serial","reason":"serial-console","selectable":false},
    {"id":"gpio.5","label":"TFT CS / GPIO5","gpio":5,"capabilities":["output"],"electrical":"onboard display","reserved_for":"system.display","reason":"tft-chip-select","selectable":false},
    {"id":"gpio.9","label":"IR transmitter / GPIO9","gpio":9,"capabilities":["output"],"electrical":"onboard IR transmitter","reserved_for":"system.ir","reason":"ir-output","selectable":false},
    {"id":"gpio.10","label":"Red LED / GPIO10","gpio":10,"capabilities":["output"],"electrical":"onboard red LED","reserved_for":"system.led-feedback","reason":"feedback-led","selectable":false},
    {"id":"gpio.13","label":"TFT clock / GPIO13","gpio":13,"capabilities":["output"],"electrical":"onboard display","reserved_for":"system.display","reason":"tft-clock","selectable":false},
    {"id":"gpio.15","label":"TFT MOSI / GPIO15","gpio":15,"capabilities":["output"],"electrical":"onboard display; boot strap","reserved_for":"system.display","reason":"tft-mosi","selectable":false},
    {"id":"gpio.18","label":"TFT reset / GPIO18","gpio":18,"capabilities":["output"],"electrical":"onboard display","reserved_for":"system.display","reason":"tft-reset","selectable":false},
    {"id":"gpio.21","label":"Internal I2C SDA / GPIO21","gpio":21,"capabilities":["input","output","open-drain"],"electrical":"3.3V I2C","reserved_for":"bus.i2c.internal","reason":"internal-i2c-bus","bus":"i2c.internal","selectable":false},
    {"id":"gpio.22","label":"Internal I2C SCL / GPIO22","gpio":22,"capabilities":["input","output","open-drain"],"electrical":"3.3V I2C","reserved_for":"bus.i2c.internal","reason":"internal-i2c-bus","bus":"i2c.internal","selectable":false},
    {"id":"gpio.23","label":"TFT DC / GPIO23","gpio":23,"capabilities":["output"],"electrical":"onboard display","reserved_for":"system.display","reason":"tft-data-command","selectable":false},
    {"id":"gpio.26","label":"HAT GPIO26","gpio":26,"capabilities":["input","output","adc","pwm","interrupt","rmt"],"electrical":"3.3V HAT pin"},
    {"id":"gpio.32","label":"Grove GPIO32","gpio":32,"capabilities":["input","output","adc","pwm","interrupt","open-drain","rmt"],"electrical":"3.3V Grove pin"},
    {"id":"gpio.33","label":"Grove GPIO33","gpio":33,"capabilities":["input","output","adc","pwm","interrupt","open-drain","rmt"],"electrical":"3.3V Grove pin"},
    {"id":"gpio.34","label":"Microphone data / GPIO34","gpio":34,"capabilities":["input"],"electrical":"input only","reserved_for":"system.microphone","reason":"onboard-microphone-data","selectable":false},
    {"id":"gpio.35","label":"PMU/IMU/RTC interrupt / GPIO35","gpio":35,"capabilities":["input","interrupt"],"electrical":"input only","reserved_for":"system.irq","reason":"onboard-shared-interrupt","selectable":false},
    {"id":"gpio.36","label":"HAT GPIO36","gpio":36,"capabilities":["input","adc","interrupt"],"electrical":"3.3V input-only HAT pin"},
    {"id":"gpio.37","label":"Button A / GPIO37","gpio":37,"capabilities":["input","interrupt"],"electrical":"input only","reserved_for":"system.button","reason":"button-a","selectable":false},
    {"id":"gpio.39","label":"Button B / GPIO39","gpio":39,"capabilities":["input","interrupt"],"electrical":"input only","reserved_for":"system.button","reason":"button-b","selectable":false}
  ],
  "buses": [{"id":"i2c.internal","type":"i2c","sda":"gpio.21","scl":"gpio.22","speed_hz":400000,"members":["system.pmu","system.imu","system.rtc"]}]
}
